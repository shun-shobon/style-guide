{
	"name": "style-guide",
	"type": "module",
	"description": "shun-shobon's engineering style guide monorepo",
	"repository": {
		"type": "git",
		"url": "https://github.com/shun-shobon/style-guide.git"
	},
	"homepage": "https://github.com/shun-shobon/style-guide#readme",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech> (https://s2n.tech/)",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"build": "pnpm -r --filter './packages/*' run build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"release": "pnpm build && changeset publish",
		"test:smoke": "pnpm --filter smoke run test",
		"typecheck": "pnpm -r --filter './packages/*' run typecheck",
		"typegen": "pnpm --filter @shun-shobon/eslint-config run typegen",
		"version-package": "changeset version && pnpm format"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@shun-shobon/eslint-config": "workspace:*",
		"@shun-shobon/prettier-config": "workspace:*",
		"@types/node": "24.19.1",
		"eslint": "10.12.0",
		"prettier": "3.9.9",
		"tsdown": "0.22.14",
		"typescript": "5.9.3"
	}
}
