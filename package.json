{
	"name": "style-guide",
	"private": true,
	"description": "shun-shobon's engineering style guide monorepo",
	"homepage": "https://github.com/shun-shobon/style-guide#readme",
	"license": "MIT",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech> (https://s2n.tech/)",
	"repository": {
		"type": "git",
		"url": "https://github.com/shun-shobon/style-guide.git"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter './packages/*' run build",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --disable-nested-config",
		"lint:fix": "oxlint --disable-nested-config --fix",
		"test:smoke": "pnpm --filter smoke run test",
		"typecheck": "pnpm -r --filter './packages/*' run typecheck"
	},
	"devDependencies": {
		"@shun-shobon/oxfmt-config": "workspace:*",
		"@shun-shobon/oxlint-config": "workspace:*",
		"@types/node": "24.19.2",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2004",
		"tsdown": "0.23.1",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@12.11.2"
}
