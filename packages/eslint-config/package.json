{
	"name": "@shun-shobon/eslint-config",
	"version": "3.0.0",
	"type": "module",
	"description": "shun-shobon's ESLint config",
	"repository": {
		"type": "git",
		"url": "https://github.com/shun-shobon/style-guide.git"
	},
	"homepage": "https://github.com/shun-shobon/style-guide/tree/main/packages/eslint-config#readme",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech> (https://s2n.tech/)",
	"license": "MIT",
	"exports": {
		".": {
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"typegen": "node --experimental-transform-types scripts/typegen.ts"
	},
	"peerDependencies": {
		"eslint": "^10.4.0"
	},
	"dependencies": {
		"@eslint-react/eslint-plugin": "5.24.8",
		"@eslint/core": "1.2.1",
		"@eslint/js": "10.0.1",
		"@next/eslint-plugin-next": "16.4.0",
		"@typescript-eslint/parser": "8.71.1",
		"astro-eslint-parser": "3.2.0",
		"eslint-config-flat-gitignore": "2.4.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-astro": "3.2.1",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-n": "18.4.1",
		"eslint-plugin-qwik": "1.20.2",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-storybook": "10.6.1",
		"eslint-plugin-unicorn": "77.0.0",
		"globals": "17.13.0",
		"local-pkg": "1.2.1",
		"typescript-eslint": "8.71.1"
	},
	"devDependencies": {
		"eslint-typegen": "2.3.1"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"sideEffects": false
}
