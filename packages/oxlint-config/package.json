{
	"name": "@shun-shobon/oxlint-config",
	"version": "7.1.0",
	"description": "shun-shobon's Oxlint config",
	"homepage": "https://github.com/shun-shobon/style-guide/tree/main/packages/oxlint-config#readme",
	"license": "MIT",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech> (https://s2n.tech/)",
	"repository": {
		"type": "git",
		"url": "https://github.com/shun-shobon/style-guide.git"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": "./dist/index.mjs"
		},
		"./plugin": {
			"import": "./dist/plugin.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"local-pkg": "1.2.1"
	},
	"devDependencies": {
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004"
	},
	"peerDependencies": {
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003"
	},
	"peerDependenciesMeta": {
		"oxlint-tsgolint": {
			"optional": true
		}
	}
}
